# Unified XSIAM / SOC environment variables
# Never commit real credentials. Use Replit Secrets or your deployment secret store.

# Database
DATABASE_URL=postgresql://soc_user:soc_password@localhost:5432/soc_triage
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=soc_password
POSTGRES_DB=soc_triage

# Auth
SESSION_SECRET=change-me-to-a-long-random-string-in-production
JWT_SECRET=change-me-to-a-long-random-string-in-production
ALLOWED_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Wazuh API (required for live ingestion)
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=
# Keep true in production. Set false only for an isolated lab with self-signed TLS.
WAZUH_VERIFY_TLS=true

# AI — optional when using n8n SOAR
GEMINI_API_KEY=
